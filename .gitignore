# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/

# Test & lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment files (real secrets ignored; the committed template is not)
.env
.env.*
!.env.example

# Terraform local working state (infra/) — provider cache, any state that ends
# up on disk, saved plans, and every tfvars variant carrying the SSH ingress
# CIDR. The pattern is `*.tfvars`, not `terraform.tfvars`: Terraform also loads
# `*.auto.tfvars` and `*.tfvars.json` automatically, and a `-var-file` accepts
# any name at all, so pinning one filename ignores the file the operator was
# told to create and none of the ones they might create instead. An explicit
# negation keeps a committed `.tfvars.example` template possible.
# The lock file .terraform.lock.hcl is NOT ignored: it is committed on purpose
# so CI and local runs resolve identical provider builds.
.terraform/
*.tfstate*
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example

# IDE / editor
.idea/
.vscode/

# OS
.DS_Store
